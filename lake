#!/bin/sh
# Run Lake with this checkout's native settings; use ./lake on every host.
# Linux: the bundled clang and llvm-ar can require a newer glibc than the host has, so
# put Homebrew's bin first when present, compile with clang from PATH, archive with
# binutils ar, and link against the toolchain lib dirs.
# macOS: pass through; Apple's ar cannot read Lake's @rsp response files.
export PATH="$HOME/.elan/bin:$PATH"
if [ "$(uname -s)" = Linux ]; then
  export PATH="/home/linuxbrew/.linuxbrew/bin:$PATH"
  export LEAN_CC=clang
  export LEAN_AR=/usr/bin/ar
  # elan names toolchain directories with `/` -> `--` and `:` -> `---`.
  _TCNAME="$(tr -d ' \n' < "$(dirname "$0")/lean-toolchain" | sed 's|/|--|g; s|:|---|g')"
  _TC="$HOME/.elan/toolchains/${_TCNAME}"
  if [ ! -d "$_TC" ]; then
    printf 'lake wrapper: no toolchain at %s\n' "$_TC" >&2
    printf '  lean-toolchain says %s; run `elan toolchain install` for it.\n' \
      "$(cat "$(dirname "$0")/lean-toolchain")" >&2
    exit 1
  fi
  export LIBRARY_PATH="${_TC}/lib:${_TC}/lib/lean${LIBRARY_PATH:+:$LIBRARY_PATH}"
fi
exec lake "$@"
