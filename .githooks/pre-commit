#!/bin/sh
# Shared native hygiene; CI installs both optional developer tools below.
set -e
cd "$(git rev-parse --show-toplevel)"
git diff --quiet -- || {
  printf 'hook: stage or restore tracked changes so checks inspect the committed content\n' >&2
  exit 1
}
sh tests/hygiene.sh
sh tests/gates.sh
if command -v actionlint >/dev/null; then
  actionlint -shellcheck='' -pyflakes=''
else
  printf 'actionlint absent; workflow validation runs in CI — see README.md\n'
fi
if command -v lean-fmt >/dev/null; then
  lean-fmt check
else
  printf 'lean-fmt absent; semantic lint runs in CI — see README.md\n'
fi
